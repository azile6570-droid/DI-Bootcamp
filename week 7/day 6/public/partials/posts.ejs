<section class="mt-4" aria-live="polite">
  <% if (message) { %>
    <p class="alert alert-info" role="status"><%= message %></p>
  <% } %>

  <% if (posts.length) { %>
    <div class="row g-4">
      <% posts.forEach((post) => { %>
        <div class="col-12">
          <article class="card shadow-sm">
            <div class="card-body">
              <h2 class="h4 card-title">
                <a href="<%= post.link %>" target="_blank" rel="noopener noreferrer"><%= post.title %></a>
              </h2>
              <p class="text-muted mb-2">
                <% if (post.publishedAt) { %>
                  <time datetime="<%= post.publishedAt %>"><%= post.publishedDate %></time>
                <% } else { %>
                  Publication date unavailable
                <% } %>
                &middot; By <%= post.creator %>
                &middot; Category: <%= post.categories.length ? post.categories.join(', ') : 'Uncategorized' %>
              </p>
              <div class="fact-content"><%= post.content %></div>
            </div>
          </article>
        </div>
      <% }); %>
    </div>
  <% } %>
</section>
